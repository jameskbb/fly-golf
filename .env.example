# Copy to .env and adjust. Never commit .env. No credentials are required:
# the MaleCNS v1.0 flat connectome is public (CC BY 4.0) and needs no neuPrint token.

# Backend (FastAPI / uvicorn)
FLY_GOLF_API_HOST=127.0.0.1
FLY_GOLF_API_PORT=8000

# Where `make data` stores raw downloads (data/raw) and the compiled graph (data/compiled)
# FLY_GOLF_DATA_DIR=./data

# Where experiment run records (JSONL) are written
# FLY_GOLF_RUNS_DIR=./runs

# Save per-shot detailed neural traces (population spike counts per 10 ms bin). Off by default.
FLY_GOLF_DETAILED_TRACES=0

# Frontend: backend origin used by the Vite dev proxy
VITE_API_URL=http://127.0.0.1:8000

# Optional, NOT required by any current code path. Only if you add neuPrint queries later:
# NEUPRINT_APPLICATION_CREDENTIALS=
