# --- Connectome data: NEVER commit (large, separately licensed, fetched by tooling) ---
data/raw/
data/normalized/
data/compiled/
*.feather
*.arrow
*.npz

# --- Runtime output (experiment runs, traces, checkpoints) ---
# anchored: the recorder writes to the root runs/; apps/web/public/showcase/runs/ is published
/runs/
outputs/
*.jsonl.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# --- Node / frontend ---
node_modules/
apps/web/dist/
*.tsbuildinfo
.vite/

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.token

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# Local smoke-test runs
.smoke-runs/

# --- Social shorts (social/) ---
# The sources are committed: the edit list, the copy, and the capture/render tools. Everything they
# produce is not: gameplay clips, rendered video, caption PNGs and synthesized audio are all
# regenerated by social/<short>/README.md's rebuild command. The finished short that the site and
# the README link to lives at apps/web/public/media/ and IS committed.
social/*/clips/
social/*/render/
social/*/captions/
social/*/audio/
social/*/*.mp4
# Short 01 is superseded by short 02 (same hole, UI in frame, no music); kept locally, not published.
social/short-01/
social/*/tools/ffmpeg-path.txt
